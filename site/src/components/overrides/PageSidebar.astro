---
import Default from '@astrojs/starlight/components/PageSidebar.astro';
import CopyMarkdown from '../CopyMarkdown.astro';
import LlmDropdown from '../LlmDropdown.astro';

const { id } = Astro.locals.starlightRoute;
const isHome = !id || id === 'index';
---

{
	!isHome && (
		<div class="llm-tools">
			<CopyMarkdown slug={id} />
			<LlmDropdown />
		</div>
	)
}
<Default />

<style>
	.llm-tools {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 1rem var(--sl-sidebar-pad-x) 1rem;
		border-bottom: 1px solid var(--sl-color-gray-6);
		width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
	}
</style>
