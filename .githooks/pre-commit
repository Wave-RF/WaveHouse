#!/usr/bin/env bash
# Runs `make verify`, then prints one-line doc-sync nudges.
# Bypass: `git commit --no-verify`.

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

make verify || { echo "🛑 pre-commit: 'make verify' failed." >&2; exit 1; }

staged=$(git diff --cached --name-only 2>/dev/null)
[ -z "$staged" ] && exit 0

has() { echo "$staged" | grep -qE "$1"; }
nudges=()

if echo "$staged" | grep -E '^internal/api/.*\.go$' | grep -qvE '_test\.go$'; then
  has '^docs/src/content/docs/api\.md$' || nudges+=("docs/src/content/docs/api.md not staged with internal/api/*.go")
  has '^clients/ts/src/' || nudges+=("clients/ts/src/ not staged with internal/api/*.go")
fi
if has '^internal/config/config\.go$'; then
  has '^docs/src/content/docs/configuration\.md$' || nudges+=("docs/src/content/docs/configuration.md not staged with config.go")
  has '^config\.yaml$' || nudges+=("config.yaml not staged with config.go")
  echo "$staged" | grep -qE '^deployments/compose/' || nudges+=("deployments/compose/* not staged with config.go")
fi
if has '^internal/ingest/types\.go$'; then
  has '^docs/src/content/docs/api\.md$' || nudges+=("docs/src/content/docs/api.md not staged with ingest/types.go")
  has '^clients/ts/src/' || nudges+=("clients/ts/src/ not staged with ingest/types.go")
fi
if echo "$staged" | grep -E '^(internal|cmd|clients/ts/src)/' | grep -qvE '_test\.(go|ts)$'; then
  has '^CHANGELOG\.md$' || nudges+=("CHANGELOG.md [Unreleased] not staged")
fi

[ ${#nudges[@]} -gt 0 ] && printf '📋 %s\n' "${nudges[@]}" >&2
exit 0
