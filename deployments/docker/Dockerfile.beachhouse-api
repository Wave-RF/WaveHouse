FROM golang:1.25-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /beachhouse-api ./cmd/beachhouse-api

FROM gcr.io/distroless/static-debian12
COPY --from=builder /beachhouse-api /beachhouse-api
COPY config.yaml /config.yaml
ENTRYPOINT ["/beachhouse-api"]
