<?xml version="1.0"?>
<!--
  Cluster + ZooKeeper topology for the SigNoz ClickHouse. Mounted at
  /etc/clickhouse-server/config.d/cluster.xml via deployments/signoz/compose.yaml.

  Single-node by design; the commented-out blocks below are templates for
  expanding to multi-shard / multi-replica if this stack ever leaves a
  laptop.

  Modeled on upstream SigNoz v0.122.0:
    https://github.com/SigNoz/signoz/blob/v0.122.0/deploy/docker/clickhouse-setup/cluster.xml
-->
<clickhouse>
    <zookeeper>
        <node index="1">
            <host>zookeeper-1</host>
            <port>2181</port>
        </node>
        <!-- Quorum template — uncomment if running multi-node ZK:
        <node index="2">
            <host>zookeeper-2</host>
            <port>2181</port>
        </node>
        <node index="3">
            <host>zookeeper-3</host>
            <port>2181</port>
        </node>
        -->
    </zookeeper>

    <remote_servers>
        <cluster>
            <shard>
                <replica>
                    <host>clickhouse</host>
                    <port>9000</port>
                </replica>
            </shard>
            <!-- Additional shards — uncomment to scale out:
            <shard>
                <replica>
                    <host>clickhouse-2</host>
                    <port>9000</port>
                </replica>
            </shard>
            <shard>
                <replica>
                    <host>clickhouse-3</host>
                    <port>9000</port>
                </replica>
            </shard>
            -->
        </cluster>
    </remote_servers>
</clickhouse>
