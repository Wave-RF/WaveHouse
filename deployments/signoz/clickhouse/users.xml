<?xml version="1.0"?>
<!--
  Vendored from upstream SigNoz at v0.122.0:
    https://github.com/SigNoz/signoz/blob/v0.122.0/deploy/docker/clickhouse-setup/users.xml

  Mounted at /etc/clickhouse-server/users.xml via deployments/signoz/compose.yaml.
  Element values are upstream-verbatim; upstream's tutorial-style comments
  have been stripped to keep the diff reviewable.

  To re-sync against a newer SigNoz release:
    curl -sL https://raw.githubusercontent.com/SigNoz/signoz/<tag>/deploy/docker/clickhouse-setup/users.xml \
      > deployments/signoz/clickhouse/users.xml
  then re-strip comments and bump the tag above.
-->
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>10000000000</max_memory_usage>
            <load_balancing>random</load_balancing>
        </default>

        <readonly>
            <readonly>1</readonly>
        </readonly>
    </profiles>

    <users>
        <default>
            <password></password>
            <!-- ::/0 opens access from any address, paired with the empty password
                 above. Acceptable here because this ClickHouse is internal to the
                 SigNoz stack (ports unpublished) — would be a footgun otherwise. -->
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
        </default>
    </users>

    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <!-- All zeros = no limits; quota is just for resource accounting. -->
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>
