# The prebuilt-binary image. Despite the name, GoReleaser no longer drives
# this file: cgo made cross-compiling impossible for darwin, so the release
# pipeline builds each binary on its own native runner and
# .github/workflows/release.yml (and publish-dev.yml, and the no-push
# validation in goreleaser-validate.yml) invokes `docker buildx build` on it
# directly. The build CONTRACT is unchanged and those workflows reproduce it
# exactly — a context holding `<os>/<arch>/wavehouse` per target plus
# go.mod, which names the chtypes CLI version. The name is kept so published
# image history, `docker history` output and every doc reference stay valid.
#
# Tiny stage just to mkdir + chown the state directories. Distroless has no
# shell, so the runtime image can't run RUN commands itself; we materialise
# the layout here and COPY it into the final image. Keeps this variant in
# lockstep with deployments/Dockerfile (source-build) so the two images expose
# the same /app filesystem layout to operators.
#
# Only the parents are pre-created — the binary mkdirs `nats/` and `pebble/`
# subdirs itself when NATS/Pebble open their stores. Named-volume copy-up
# runs against `/app/data`; bind mounts mask the image dir entirely and
# require the host directory to be writable by UID 65532.

# Pin to the builder's native arch via $BUILDPLATFORM. Without this, a
# cross-arch build (e.g. linux/arm64 from an amd64 builder) would default
# this FROM to the target platform — pulling arm64 alpine and executing
# arm64 mkdir/chown under QEMU. Since the stage's only outputs are
# directory entries + UID metadata (arch-agnostic bytes), building it
# once natively and COPY'ing into each target image is correct AND
# removes the binfmt/QEMU dependency entirely.
FROM --platform=$BUILDPLATFORM alpine:3 AS layout
# /app/settings is the empty settings-directory mount point, and
# /var/cache/chtypes the chtypes cache — see the same RUN in
# deployments/Dockerfile; keep the two in lockstep.
RUN mkdir -p /app/data /app/settings /var/cache/chtypes && chown -R 65532:65532 /app /var/cache/chtypes

# The chtypes CLI for THIS image's target platform, at the SDK version go.mod
# requires. Pure Go (CGO_ENABLED=0), so it cross-compiles natively on
# $BUILDPLATFORM like `layout` above, with no QEMU. No artifact is baked in
# (see deployments/Dockerfile). go.mod is copied into the context by the
# "Assemble the image build context" step of release.yml, publish-dev.yml and
# goreleaser-validate.yml; it is read here under another name so it never
# selects this stage's toolchain.
FROM --platform=$BUILDPLATFORM golang:1.27-bookworm AS chtypes-cli
ARG TARGETOS
ARG TARGETARCH
COPY go.mod /tmp/wavehouse.go.mod
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    v="$(sed -n 's#^[[:space:]]*github.com/wave-rf/chtypes/go \(v[^[:space:]]*\).*#\1#p' /tmp/wavehouse.go.mod)" && \
    test -n "$v" && \
    GOOS="$TARGETOS" GOARCH="$TARGETARCH" CGO_ENABLED=0 \
      go install -trimpath -ldflags="-s -w" "github.com/wave-rf/chtypes/go/cmd/chtypes@$v" && \
    bin="$(go env GOPATH)/bin" && \
    if [ -f "$bin/${TARGETOS}_${TARGETARCH}/chtypes" ]; then cp "$bin/${TARGETOS}_${TARGETARCH}/chtypes" /chtypes; \
    else cp "$bin/chtypes" /chtypes; fi

FROM gcr.io/distroless/cc-debian12

# buildx injects this per target platform of a `--platform a,b` build
ARG TARGETPLATFORM

WORKDIR /app
USER nonroot:nonroot
ENV WH_SETTINGS_DIR=/app/settings
# Read by both the process (an empty clickhouse.chtypes_cache defers to it)
# and the bundled CLI, so a fetch either one makes lands where the other
# looks.
ENV CHTYPES_CACHE=/var/cache/chtypes

# Pre-created state directories owned by the nonroot user (UID 65532) so
# the binary can mkdir under /app/data without a volume mount, and so
# bind-mounting empty volumes at /app/data inherits correct ownership.
COPY --from=layout --chown=nonroot:nonroot /app /app
COPY --from=layout --chown=nonroot:nonroot /var/cache/chtypes /var/cache/chtypes
COPY --from=chtypes-cli --chown=nonroot:nonroot /chtypes /app/chtypes

# Copy the binary from its platform-specific subdirectory of the context —
# `linux/amd64/wavehouse`, `linux/arm64/wavehouse`. The workflow stages each
# native runner's binary there with mode 0755 (actions/upload-artifact's zip
# carries no unix mode bits, so the executable bit has to be restored).
COPY --chown=nonroot:nonroot $TARGETPLATFORM/wavehouse /app/wavehouse

# OCI image metadata. Static labels here; the publishing workflows pass the
# per-build ones (revision, version, created, and a dev-suffixed title and
# description on the :dev channel) as `docker buildx build --label`, which
# take precedence. The static set below is the floor — guaranteed even when a
# label is missing from the command line, e.g. on a local `docker build`.
LABEL org.opencontainers.image.title="WaveHouse"
LABEL org.opencontainers.image.description="Schema-aware real-time API gateway for ClickHouse"
LABEL org.opencontainers.image.url="https://github.com/Wave-RF/WaveHouse"
LABEL org.opencontainers.image.source="https://github.com/Wave-RF/WaveHouse"
LABEL org.opencontainers.image.logo="https://raw.githubusercontent.com/Wave-RF/WaveHouse/refs/heads/main/docs/public/apple-touch-icon.png"
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.vendor="Wave RF"

# more custom labels for the WaveHouse project, not part of the OCI spec
LABEL dev.orbstack.icon="https://raw.githubusercontent.com/Wave-RF/WaveHouse/refs/heads/main/docs/public/apple-touch-icon.png"
LABEL com.docker.extension.icon="https://raw.githubusercontent.com/Wave-RF/WaveHouse/refs/heads/main/docs/public/apple-touch-icon.png"

# Declares /app/data as a managed mount point. If the operator runs the
# container without an explicit volume or bind mount, Docker creates an
# anonymous volume here automatically — preventing JetStream/Pebble state
# from landing on the writable overlay layer (where it'd be wiped on
# every restart). Doesn't override or interact with explicit `-v` /
# compose `volumes:` declarations; those still take precedence.
#
# The settings directory (/app/settings) is intentionally NOT a VOLUME — it's
# operator config the process only reads, and an anonymous volume would hide
# a missing mount instead of refusing to boot. See docs/deployment.md.
VOLUME ["/app/data"]

# Default listen port. ENV is just a default — compose `environment:` or
# `docker run -e` overrides it normally — and EXPOSE is image-metadata
# documentation only, not a port publish. If you set WH_SERVER_PORT to
# something else, also update your compose `ports:` mapping accordingly;
# Docker can't recompute EXPOSE at runtime.
ENV WH_SERVER_PORT=8080
EXPOSE 8080

# Liveness probe via the binary's built-in `health` subcommand — does an
# HTTP GET to /livez on localhost. Distroless has no shell or curl, so
# the subcommand approach is the standard pattern here.
#
# --interval=10s: probe every 10 seconds
# --timeout=3s:   in-process check itself caps at 2s
# --start-period=15s: grace window for schema discovery + NATS init
# --retries=3:    three consecutive failures before unhealthy
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
  CMD ["/app/wavehouse", "health"]

ENTRYPOINT ["/app/wavehouse"]
