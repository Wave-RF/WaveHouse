{
  "clickhouse": {
    "addr": "clickhouse:9000",
    "http_port": 8123,
    "http_scheme": "http",
    "database": "default",
    "username": "default",
    "password": "",
    "query_timeout": 30,
    "insert_timeout": 30,
    "tls": {
      "enabled": false,
      "ca_file": "",
      "cert_file": "",
      "key_file": "",
      "insecure_skip_verify": false,
      "server_name": ""
    },
    "headers": {},
    "max_open_conns": 10,
    "max_idle_conns": 5
  },
  "auth": {
    "jwks_url": "",
    "jwt_secret": "",
    "role_claim": "role"
  },
  "dedupe": {
    "enabled": false,
    "id_field": "event_id",
    "require_id": false,
    "retention": "0",
    "tables": {}
  },
  "dlq": {
    "enabled": true,
    "tables": {}
  },
  "ingest": {
    "max_batch_bytes": 262144,
    "max_batch_wait_ms": 5000,
    "retry_backoff_max": 30
  },
  "query": {
    "default_max_rows": 10000,
    "timestamp_bucket_seconds": 60
  },
  "schema": {
    "refresh_interval": 60
  },
  "stream": {
    "keepalive_interval": 30,
    "keepalive_buckets": 3,
    "gap_window_minutes": 15,
    "subscriber_queue": 64
  },
  "mq": {
    "max_bytes_gb": 50
  },
  "cors": {
    "allowed_origins": [
      "*"
    ]
  }
}
