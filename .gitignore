# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Build artifacts
tmp/
dist/

# Build directories
build/
bin/

# Stray binaries from `go build ./scripts/<name>` — Go helpers under scripts/
# are meant to be run via `go run` (the Makefile drives them that way), but a
# direct `go build ./scripts/cov` would drop the binary at the repo root
# because Go uses the package's directory basename as the output name.
# `go build ./...` of multiple main packages already discards outputs, so
# this only catches the explicit single-package case. One line per helper.
/orchestrator
/cov

# Data directories (runtime)
data/

# Test artifacts
*.test
*.out

# Coverage outputs
coverage.txt
coverage.out
# vitest's default coverage dir, used when `pnpm test:coverage` runs
# without SDK_COVERAGE_DIR set (i.e. directly inside clients/ts/).
coverage/
clients/ts/coverage/

# Local Tooling directory
tools/
.bin/

# Dependency directories
vendor/
node_modules/

# IDE / Editor
.idea/
*.swp
*.swo
*~

# Claude Code local state (per-user; not for committing)
.claude/settings.local.json
.claude/worktrees/

# Local git worktrees
.worktrees/

# OS files
.DS_Store
Thumbs.db

# Environment files
.env
.env.local
.env.*.local
!.github/board-config.env

# SigNoz dev-stack JWT secret (generated by `make signoz-up`, rotated by
# `make signoz-wipe`). Never shared — each checkout gets its own value.
deployments/signoz/.signoz-secret.local

# Debug
__debug_bin*

# Docs site build outputs
docs/.astro/
docs/.env.production
docs/.wrangler/
docs/dist/

# pnpm
pnpm-debug.log*

# local config files
.config.local.yaml
.policy.local.yaml
