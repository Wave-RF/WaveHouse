    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@wave-rf/astro-themed-mermaid": "^0.4.0",
    "@wave-rf/astro-trademarks": "^0.1.0",
