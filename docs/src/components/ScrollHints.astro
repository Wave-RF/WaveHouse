---
// Horizontal-scroll affordances for code blocks, tables, and Mermaid
// diagrams. Two jobs:
//
// 1. Wrap each bare Mermaid <svg> (rehype-mermaid emits them as direct
//    children of .sl-markdown-content) in a .wh-scroll-x scroller, so on
//    mobile the diagram keeps a readable size and pans instead of shrinking
//    to a 3px-label thumbnail. No-JS keeps the old scale-to-fit CSS — the
//    `> svg` carve-out in global.css stops matching once the svg is wrapped,
//    which re-enables the readable min-width inside the scroller.
//
// 2. Stamp [data-wh-more] on any of these scrollers that has content hidden
//    to the right; CSS fades the right edge so cut-off content reads as
//    "scrollable", not "clipped". The attribute clears as you reach the end.
//
// Rendered once from Footer.astro (every page). Same is:inline + window-flag
// convention as MermaidZoom for view-transition safety.
---

<script is:inline>
  (() => {
    const SCROLLERS =
      ".expressive-code pre, .sl-markdown-content table, .wh-scroll-x, .wh-zoom__stage";

    function wrapScrollables() {
      const bare = document.querySelectorAll(
        ".sl-markdown-content > svg[aria-roledescription]",
      );
      for (const svg of bare) {
        const div = document.createElement("div");
        div.className = "wh-scroll-x";
        svg.replaceWith(div);
        div.append(svg);
      }
      // Surface each diagram's natural width (Mermaid stamps it as an inline
      // max-width) as a custom property. global.css uses it as the min-width
      // pin on phones only — pan at natural size beats 5px labels there —
      // while desktop keeps scale-to-fit (an unconditional inline min-width
      // here once forced wide diagrams into horizontal scrollers at every
      // viewport).
      for (const svg of document.querySelectorAll(
        ".wh-scroll-x > svg[aria-roledescription], .sl-markdown-content :is(p, div) > svg[aria-roledescription]",
      )) {
        if (svg.style.maxWidth) {
          svg.style.setProperty("--wh-natural-w", svg.style.maxWidth);
        }
      }
      // Paired diagrams already live in a <p>/<div> wrapper that global.css
      // makes scrollable; give those the same class so they share the scrim
      // and the touch zoom hint.
      const wrapped = document.querySelectorAll(
        ".sl-markdown-content :is(p, div) > svg[aria-roledescription]",
      );
      for (const svg of wrapped) {
        const parent = svg.parentElement;
        if (parent && !parent.classList.contains("wh-scroll-x")) {
          parent.classList.add("wh-scroll-x");
        }
      }
      // Tables: a scroll WRAPPER lets the table itself use true auto layout
      // (prose wraps first; the wrapper scrolls only when unbreakable columns
      // genuinely can't fit). Without JS, the table's own display:block
      // fallback in global.css still scrolls — it just doesn't wrap prose.
      const tables = document.querySelectorAll(".sl-markdown-content table");
      for (const t of tables) {
        if (t.parentElement && t.parentElement.classList.contains("wh-table-wrap")) continue;
        const div = document.createElement("div");
        div.className = "wh-scroll-x wh-table-wrap";
        t.replaceWith(div);
        div.append(t);
      }
      tokenizeTableCode();
    }

    // Code in table cells must never split MID-token (`--url` reading as two
    // flags) — but blanket nowrap also stopped multi-word code (JSON bodies,
    // shell commands) from wrapping at its SPACES, which forced whole tables
    // into scrollers. Split each plain-text code span into per-token nowrap
    // <span>s: wrapping happens between tokens only. Tokens with interior
    // slashes (paths, endpoints) additionally get a <wbr> after each slash —
    // the conventional URL break points (a <wbr> copies as nothing, so
    // clipboard text is unchanged). The data attribute flips the CSS from the
    // no-JS nowrap fallback to normal wrapping, and keeps this idempotent
    // across view-transition reruns.
    function tokenizeTableCode() {
      for (const code of document.querySelectorAll(".wh-table-wrap code")) {
        if (code.dataset.whTok || code.children.length) continue;
        code.dataset.whTok = "1";
        const frag = document.createDocumentFragment();
        for (const part of code.textContent.split(/(\s+)/)) {
          if (!part) continue;
          if (/^\s/.test(part)) {
            frag.append(part);
            continue;
          }
          // Slash-segments each get their OWN nowrap span with the <wbr>s
          // between them in normal white-space — a <wbr> inside nowrap is
          // suppressed, and a bare normal-flow token could still break at
          // interior hyphens (the exact mid-token shred this prevents).
          const bits = part.split(/(?<=\/)(?=.)/);
          const host = document.createElement("span");
          host.className = bits.length > 1 ? "wh-tok-path" : "wh-tok";
          bits.forEach((b, i) => {
            if (bits.length > 1) {
              const seg = document.createElement("span");
              seg.className = "wh-tok";
              seg.textContent = b;
              host.append(seg);
            } else {
              host.append(b);
            }
            if (i < bits.length - 1) host.append(document.createElement("wbr"));
          });
          frag.append(host);
        }
        code.replaceChildren(frag);
      }
    }

    function updateOne(el) {
      const more = el.scrollWidth - el.clientWidth - el.scrollLeft > 3;
      el.toggleAttribute("data-wh-more", more);
    }
    function updateAll() {
      document.querySelectorAll(SCROLLERS).forEach(updateOne);
    }
    // Tables get their per-column min-width floors ONLY once they genuinely
    // overflow (data-wh-scrolls): floors stop auto layout crushing off-screen
    // columns inside a scroller, but applied unconditionally they FORCED
    // tables that would fit by wrapping into scrollers. Measure with floors
    // off (remove all attrs first so a single reflow covers every table),
    // then stamp the ones that still can't fit — plus the ones that "fit"
    // only by CROWDING: a many-column table squeezed to a sliver per column
    // wraps every other word and reads worse than a clean sideways pan, so
    // below ~8.5rem of average column width it scrolls instead.
    function classifyTables() {
      const CROWD_PX = 136;
      const wraps = document.querySelectorAll(".wh-table-wrap");
      wraps.forEach((el) => el.removeAttribute("data-wh-scrolls"));
      wraps.forEach((el) => {
        const row = el.querySelector("tr");
        const cols = row ? row.cells.length : 0;
        const crowded = cols >= 4 && el.clientWidth / cols < CROWD_PX;
        if (crowded || el.scrollWidth - el.clientWidth > 1) {
          el.setAttribute("data-wh-scrolls", "");
        }
      });
    }
    function init() {
      wrapScrollables();
      classifyTables();
      updateAll();
    }

    init();
    if (window.__whScrollHintsBound) return;
    window.__whScrollHintsBound = true;
    document.addEventListener("astro:page-load", init);
    window.addEventListener(
      "resize",
      () =>
        requestAnimationFrame(() => {
          classifyTables();
          updateAll();
        }),
      { passive: true },
    );
    // Element scroll events don't bubble, but they do capture.
    document.addEventListener(
      "scroll",
      (e) => {
        const t = e.target;
        if (t instanceof Element && t.matches && t.matches(SCROLLERS)) {
          updateOne(t);
        }
      },
      { capture: true, passive: true },
    );
  })();
</script>

<style is:global>
  .wh-scroll-x {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
    scrollbar-color: var(--wh-border-strong) transparent;
    margin-block: 1rem;
    position: relative;
  }
  /* The right-edge fade: content hidden past the edge reads as scrollable
     instead of amputated. Cleared by the script at scroll end. */
  [data-wh-more] {
    mask-image: linear-gradient(90deg, #000 calc(100% - 32px), transparent);
  }
  /* Wrapped tables: the wrapper carries the card frame so the border doesn't
     scroll away with the content; the table inside reverts to true auto
     layout at full wrapper width (overriding the no-JS block fallback). */
  .wh-table-wrap {
    border: 1px solid var(--wh-border);
    border-radius: var(--radius-md);
  }
  .wh-table-wrap > table,
  .sl-markdown-content .wh-table-wrap > table {
    display: table;
    width: 100%;
    max-width: none;
    overflow: visible;
    border: 0;
    margin: 0;
  }
  /* Horizontal room is free inside a scroller — never let a column crush.
     Without floors, auto layout squeezed off-screen prose columns to ~100px,
     whose 10-20 wrapped lines drove the row height and left near-blank
     viewport-tall rows on phones. The last column (the docs' description
     column by convention) gets a real reading measure. Scoped to tables the
     script has measured as genuinely overflowing — on fitting tables the
     floors themselves would create the scroll. */
  .wh-table-wrap[data-wh-scrolls] :is(th, td) {
    min-width: 6rem;
  }
  .wh-table-wrap[data-wh-scrolls] :is(th, td):last-child {
    min-width: min(26rem, 75vw);
  }
  /* Code chips in cells never break mid-token (`--url` was splitting at its
     hyphens into what read as separate flags). The nowrap here is the no-JS
     fallback (the scroller absorbs the width); once the script tokenizes a
     span ([data-wh-tok]) wrapping happens BETWEEN tokens — at spaces, and
     after slashes in paths — while each token stays atomic in its own
     nowrap span. */
  .wh-table-wrap code {
    white-space: nowrap;
  }
  .wh-table-wrap code[data-wh-tok] {
    white-space: normal;
  }
  .wh-table-wrap .wh-tok {
    white-space: nowrap;
  }
  .wh-table-wrap .wh-tok-path {
    white-space: normal;
  }
  /* Touch screens get an explicit zoom affordance on diagrams — cursor:
     zoom-in means nothing without a pointer. */
  @media (pointer: coarse) {
    .wh-scroll-x:not(.wh-table-wrap)::after {
      content: "⤢";
      position: absolute;
      top: 0.4rem;
      right: 0.4rem;
      display: grid;
      place-items: center;
      width: 1.6rem;
      height: 1.6rem;
      border-radius: var(--radius-xs);
      background: var(--wh-surface-overlay);
      border: 1px solid var(--wh-border-strong);
      color: var(--wh-ink-muted);
      font-size: 0.95rem;
      line-height: 1;
      pointer-events: none;
    }
  }
</style>
