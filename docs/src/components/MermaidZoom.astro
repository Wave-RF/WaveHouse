---
// Click-to-zoom for Mermaid diagrams. Dense diagrams read small inline;
// clicking any diagram opens it in a lightbox that always FITS the viewport
// (small diagrams scale up, capped 2.5×; oversized ones scale down — never
// scrollbars by default). Diagrams larger than the stage also get a 1:1
// toggle: natural size with pan + edge fades, for full label detail.
//
// Rendered once (from Footer.astro, which is on every page). The script uses
// event delegation on `document` so it survives Astro view-transition
// navigations without re-binding, and a window flag makes init idempotent.
---

<script is:inline>
  // is:inline (not a bundled module) to match the codebase's DOM-script
  // convention (see Footer.astro) and stay out of `astro check`. With view
  // transitions this re-executes per navigation, so the window flag guards
  // against re-binding the document-level listeners; per-page work runs from
  // the persistent `astro:page-load` handler.
  (() => {
    if (window.__whMermaidZoomInit) return;
    window.__whMermaidZoomInit = true;

    const DIAGRAM = ".sl-markdown-content svg[aria-roledescription]";
    let overlay = null;
    let lastTrigger = null;

    function close() {
      if (!overlay) return;
      overlay.classList.remove("is-open");
      document.documentElement.style.removeProperty("overflow");
      const t = lastTrigger;
      lastTrigger = null;
      // Let the fade-out run before hiding (keeps it out of the a11y tree).
      window.setTimeout(() => overlay && overlay.setAttribute("hidden", ""), 180);
      if (t && typeof t.focus === "function") t.focus();
    }

    function buildOverlay() {
      overlay = document.createElement("div");
      overlay.className = "wh-zoom";
      overlay.setAttribute("hidden", "");
      overlay.setAttribute("role", "dialog");
      overlay.setAttribute("aria-modal", "true");
      overlay.setAttribute("aria-label", "Enlarged diagram");
      overlay.innerHTML =
        '<button class="wh-zoom__one" type="button" hidden aria-pressed="false" ' +
        'aria-label="Toggle natural size (pan to explore)">1:1</button>' +
        '<button class="wh-zoom__close" type="button" aria-label="Close enlarged diagram">' +
        '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" ' +
        'stroke="currentColor" stroke-width="2" stroke-linecap="round">' +
        '<path d="M6 6l12 12M18 6L6 18"/></svg></button>' +
        '<div class="wh-zoom__stage"></div>';
      overlay.addEventListener("click", (e) => {
        if (e.target.closest(".wh-zoom__one")) {
          const btn = e.target.closest(".wh-zoom__one");
          if (overlay.__whSetMode) overlay.__whSetMode(btn.getAttribute("aria-pressed") !== "true");
          return;
        }
        // Backdrop / stage padding click closes; clicks on the SVG itself don't.
        if (!e.target.closest("svg") || e.target.closest(".wh-zoom__close")) close();
      });
      document.body.appendChild(overlay);
    }

    function open(svg) {
      if (!overlay) buildOverlay();
      const stage = overlay.querySelector(".wh-zoom__stage");
      stage.replaceChildren();
      // The stage is reused across opens — a prior 1:1 pan session leaves
      // its edge-fade attributes behind, which painted a phantom fade on
      // the next (fitting) diagram.
      stage.removeAttribute("data-wh-more");
      stage.removeAttribute("data-wh-more-start");
      stage.scrollLeft = 0;
      stage.scrollTop = 0;

      // Re-id the clone rather than cloneNode-ing as-is: a Mermaid SVG scopes
      // its entire inline <style> (font-family, themed fills) by the root id
      // (`#mermaid-abc{…}`) and references markers/gradients via url(#mermaid-abc-…).
      // Two elements sharing that id in the DOM is invalid and (depending on the
      // browser) resolves the font/marker refs to the wrong one — the clone then
      // falls back to a wider font and its labels clip. Rewriting every
      // occurrence of the id to a unique one keeps the clone fully self-contained.
      const oldId = svg.getAttribute("id");
      let markup = svg.outerHTML;
      if (oldId) markup = markup.split(oldId).join(oldId + "-zoom");
      const holder = document.createElement("div");
      holder.innerHTML = markup;
      const clone = holder.firstElementChild;
      // viewBox carries the intrinsic size; fall back to the inline max-width.
      const vb = (svg.getAttribute("viewBox") || "").split(/\s+/).map(Number);
      const natW = vb.length === 4 && vb[2] ? vb[2] : svg.getBoundingClientRect().width;
      const natH = vb.length === 4 && vb[3] ? vb[3] : svg.getBoundingClientRect().height;
      // Fit inside the stage's CONTENT box: its max-width/height (94vw/90vh)
      // include its own padding, so sizing against the raw viewport fractions
      // overshot by the padding and the "fully zoomed" state always showed
      // both scrollbars. Read the padding from computed style (clamp()
      // resolves without layout) rather than duplicating the CSS values here.
      const cs = getComputedStyle(stage);
      const padX = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
      const padY = parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom);
      const fit = Math.min(
        (window.innerWidth * 0.94 - padX) / natW,
        (window.innerHeight * 0.9 - padY) / natH,
      );
      // The modal ALWAYS fits the diagram to the stage — scaling UP small
      // diagrams (cap 2.5×) and DOWN oversized ones — so the default view
      // never grows scrollbars (which also squared the sheet's rounded
      // corners). Diagrams larger than the stage get a 1:1 toggle instead:
      // natural size + pan, with the ScrollHints edge fades as the wayfinding
      // (pinch-zoom also works natively on touch). Floor the pixel sizes so
      // fractional rounding can't tip a perfect fit into a 1px overflow.
      const fitScale = Math.min(fit, 2.5);
      const sizeTo = (scale) => {
        clone.style.width = Math.floor(natW * scale) + "px";
        clone.style.height = Math.floor(natH * scale) + "px";
      };
      sizeTo(fitScale);
      clone.style.maxWidth = "none";
      clone.style.minWidth = "0";
      stage.appendChild(clone);

      const oneBtn = overlay.querySelector(".wh-zoom__one");
      oneBtn.hidden = !(fit < 0.98); // 1:1 only buys anything when fit shrank it
      oneBtn.setAttribute("aria-pressed", "false");
      overlay.__whSetMode = (natural) => {
        sizeTo(natural ? 1 : fitScale);
        oneBtn.setAttribute("aria-pressed", String(natural));
        stage.scrollLeft = 0;
        stage.scrollTop = 0;
        // Stamp the edge fades for the new size (ScrollHints' capture-phase
        // scroll listener keeps them updated as the user pans).
        requestAnimationFrame(() => {
          stage.toggleAttribute(
            "data-wh-more",
            stage.scrollWidth - stage.clientWidth - stage.scrollLeft > 8,
          );
          stage.toggleAttribute("data-wh-more-start", false);
        });
      };

      overlay.removeAttribute("hidden");
      // Next frame so the un-hide paints before the open transition.
      requestAnimationFrame(() => overlay.classList.add("is-open"));
      document.documentElement.style.overflow = "hidden";
      overlay.querySelector(".wh-zoom__close").focus();
    }

    document.addEventListener("click", (e) => {
      if (overlay && !overlay.hasAttribute("hidden")) return; // already open
      const svg = e.target.closest(DIAGRAM);
      if (!svg) return;
      lastTrigger = svg;
      open(svg);
    });

    document.addEventListener("keydown", (e) => {
      if (overlay && !overlay.hasAttribute("hidden")) {
        if (e.key === "Escape") close();
        return;
      }
      // Enter/Space on a focused diagram opens it.
      if (e.key === "Enter" || e.key === " ") {
        const svg = e.target.closest && e.target.closest(DIAGRAM);
        if (svg) {
          e.preventDefault();
          lastTrigger = svg;
          open(svg);
        }
      }
    });

    // Make diagrams keyboard-focusable + hint the interaction (idempotent;
    // re-run after every view-transition navigation for the new page's DOM).
    function enhance() {
      document.querySelectorAll(DIAGRAM).forEach((svg) => {
        if (svg.dataset.whZoom) return;
        svg.dataset.whZoom = "1";
        svg.setAttribute("tabindex", "0");
        svg.setAttribute("aria-keyshortcuts", "Enter");
      });
    }
    document.addEventListener("astro:page-load", enhance);
    if (document.readyState !== "loading") enhance();
    else document.addEventListener("DOMContentLoaded", enhance);
  })();
</script>

<style is:global>
  /* Affordance: diagrams are click-to-zoom. */
  .sl-markdown-content svg[aria-roledescription] {
    cursor: zoom-in;
  }
  .sl-markdown-content svg[aria-roledescription]:focus-visible {
    outline: 2px solid var(--wh-accent-text, var(--wh-accent-hi));
    outline-offset: 4px;
    border-radius: var(--radius-sm, 8px);
  }

  .wh-zoom {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(0.5rem, 3vw, 2.5rem);
    background: color-mix(in oklab, var(--wh-bg, #0b0e13) 78%, transparent);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .wh-zoom.is-open {
    opacity: 1;
  }
  .wh-zoom[hidden] {
    display: none;
  }
  .wh-zoom__stage {
    max-width: 94vw;
    max-height: 90vh;
    overflow: auto;
    display: grid;
    /* `safe`: plain centering makes the overflow START side unreachable when
       a natural-size diagram exceeds the stage (phones could never scroll to
       the diagram's left/top edge); safe centering falls back to start. */
    place-items: safe center;
    border-radius: var(--radius-md, 12px);
    /* The cloned SVG's themed fills use --wh-mermaid-* vars resolved on
       :root, so the diagram keeps its colors inside the overlay. A surface
       backing reads as a "card" lifted off the dimmed page. */
    background: var(--wh-mermaid-surface, var(--wh-surface, #14171c));
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
    scrollbar-width: thin;
    padding: clamp(1rem, 2.5vw, 2rem);
  }
  .wh-zoom__stage > svg {
    display: block;
  }
  .wh-zoom__close,
  .wh-zoom__one {
    position: fixed;
    top: clamp(0.5rem, 2vw, 1.25rem);
    right: clamp(0.5rem, 2vw, 1.25rem);
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--wh-border, rgba(255, 255, 255, 0.14));
    background: var(--wh-surface, #14171c);
    color: var(--wh-ink, #f1f3f7);
    cursor: pointer;
    transition: background 0.12s ease, transform 0.12s ease,
      border-color 0.12s ease;
  }
  .wh-zoom__one {
    right: calc(clamp(0.5rem, 2vw, 1.25rem) + 3.1rem);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.02em;
  }
  .wh-zoom__one[hidden] {
    display: none;
  }
  .wh-zoom__one[aria-pressed="true"] {
    border-color: var(--wh-accent, #06b0bf);
    color: var(--wh-accent-text, var(--wh-accent-hi, #1dc9d8));
  }
  .wh-zoom__close:hover,
  .wh-zoom__one:hover {
    background: var(--wh-surface-2, #1b1f26);
    transform: scale(1.05);
  }
  .wh-zoom__close:focus-visible,
  .wh-zoom__one:focus-visible {
    outline: 2px solid var(--wh-accent-text, var(--wh-accent-hi));
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .wh-zoom {
      transition: none;
    }
    .wh-zoom__close {
      transition: none;
    }
  }
</style>
