---
// The WaveHouse logo — the wave mark + "WaveHouse" wordmark as ONE inline SVG,
// themed entirely by CSS (mark = --wh-accent via currentColor, wordmark =
// --wh-ink), so there are no pre-baked light/dark image variants. The full
// lockup renders at every width — it's ~5.1× its height (≈8.3rem at the header
// default), narrow enough for even a 320px bar, and a mark-only mobile
// collapse left the header/footer looking bare (PR #368 review). Reusable
// anywhere the brand logo is needed. The lockup SVG ships role/aria-label for
// the standalone brand kit, but is aria-hidden here: decorative by default —
// pass `title` to expose the logo as a labelled image when no wrapping element
// provides the name; the header's home link (SiteTitle) labels itself, so it
// passes none.
//
// lockup-themed.svg is GENERATED by docs/scripts/branding/generate.sh — do not
// hand-edit it. It must also stay comment-free: it's parsed as strict XML when
// viewed standalone, and XML comments can't contain `--` (as in --wh-ink), so
// the provenance note lives here instead.
//
// The lockup is inlined (set:html) rather than loaded through <img> for two
// reasons: CSS can theme it, and a baseline-flex parent can align adjacent text
// (e.g. the header "Docs" link) to the *wordmark* baseline. `.wh-logo` reports
// the wordmark baseline as its own via the margin-bottom anchor below — the
// wordmark baseline sits at --wh-lockup-baseline of the lockup height, and the
// slice beneath it is pulled out of the box — so alignment survives any font /
// font-size / logo-height change with no per-pixel magic number.
import lockup from "../assets/branding/lockup-themed.svg?raw";

interface Props {
  class?: string;
  title?: string;
}
const { class: className, title } = Astro.props;
---

<span
  class:list={["wh-logo", className]}
  role={title ? "img" : undefined}
  aria-label={title}
>
  <span class="wh-logo__lockup" aria-hidden="true" set:html={lockup} />
</span>

<style>
  .wh-logo {
    /* Size + theme knobs. Override --wh-logo-height to rescale the whole logo;
       everything else is derived from it. */
    --wh-logo-height: 1.625rem;
    /* Wordmark baseline as a fraction of the lockup height (y74 of the 0..100
       viewBox). The ONE geometric constant — a property of the art, not a tuned
       nudge; it only changes if the logo itself is redesigned. */
    --wh-lockup-baseline: 0.74;
    display: inline-flex;
    align-items: baseline;
    color: var(--wh-accent);
  }

  .wh-logo__lockup :global(svg) {
    display: block;
    height: var(--wh-logo-height);
    width: auto;
    /* Expose the wordmark baseline as this element's baseline: pull the box
       bottom up by the slice of the lockup that hangs below the wordmark
       baseline, so a baseline-flex parent lands on the wordmark, not the image
       bottom edge. */
    margin-bottom: calc((var(--wh-lockup-baseline) - 1) * var(--wh-logo-height));
  }
</style>
