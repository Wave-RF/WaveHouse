---
// PostHog click tracking for the homepage closing-section CTAs.
// Lives in an .astro component (not index.mdx) because MDX parses `{` as JSX
// expression syntax — a raw <script is:inline> body can't survive the MDX
// compiler. Imported by src/content/docs/index.mdx.
---
<script is:inline>
  function setupHomepageCTATracking() {
    var container = document.querySelector('.wh-closer__actions');
    if (!container) return;
    container.querySelectorAll('a').forEach(function(el) {
      el.removeEventListener('click', el.__whPhHomepageHandler);
      el.__whPhHomepageHandler = function() {
        window.posthog?.capture('homepage_cta_clicked', {
          cta_text: el.textContent?.trim(),
          cta_href: el.getAttribute('href')
        });
      };
      el.addEventListener('click', el.__whPhHomepageHandler);
    });
  }
  document.addEventListener('DOMContentLoaded', setupHomepageCTATracking);
  document.addEventListener('astro:page-load', setupHomepageCTATracking);
</script>
