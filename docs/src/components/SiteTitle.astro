---
// Starlight's site-title override — just the home link wrapping the shared
// <Logo/>. All logo rendering/theming lives in Logo.astro so it can be reused
// outside the header too.
import Logo from "./Logo.astro";
import config from "virtual:starlight/user-config";

const title =
  typeof config.title === "string" ? config.title : config.title.en ?? "WaveHouse";
const base = import.meta.env.BASE_URL;
---

<a href={base} class="wh-site-title" aria-label={`${title} home`}>
  <Logo />
</a>

<style>
  .wh-site-title {
    display: inline-flex;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .wh-site-title:hover {
    opacity: 0.8;
  }
</style>
