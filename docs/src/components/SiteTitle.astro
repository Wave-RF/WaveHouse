---
import config from "virtual:starlight/user-config";
import WaveMark from "./WaveMark.astro";

const title =
  typeof config.title === "string" ? config.title : config.title.en ?? "WaveHouse";
---

<a href={import.meta.env.BASE_URL} class="wh-site-title" aria-label={`${title} home`}>
  <span class="wh-site-title__mark" aria-hidden="true">
    <WaveMark />
  </span>
  <span class="wh-site-title__text">{title}</span>
</a>

<style>
  .wh-site-title {
    /* inline-block, NOT inline-flex, on purpose: an inline-block's baseline is
       its text's baseline, so this box exposes the wordmark's baseline to the
       header row — which baseline-aligns the "Docs" nav link to it with no pixel
       nudge (see Header.astro .wh-lead). A flex row would instead export the
       TALL mark's edge as the box baseline, which is what forced the old nudge.
       The mark is lifted out of flow (absolute, below) so only the text sets the
       baseline; its slot is reserved here as inline-start padding = mark + gap. */
    display: inline-block;
    position: relative;
    padding-inline-start: calc(1.5rem + 0.625rem);
    white-space: nowrap;
    text-decoration: none;
    color: var(--wh-ink);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 1.0625rem;
    line-height: 1;
    transition: color 0.15s ease;
  }
  .wh-site-title:hover .wh-site-title__mark {
    color: var(--wh-accent);
    transform: rotate(-2deg);
  }
  .wh-site-title:hover .wh-site-title__text {
    color: var(--wh-ink);
  }
  .wh-site-title__mark {
    /* Sits in the reserved inline-start slot, vertically centred on the wordmark
       line box. Centre with a negative margin (−½ height) rather than a translate
       so `transform` stays free for the hover rotate above. */
    position: absolute;
    inset-inline-start: 0;
    top: 50%;
    margin-top: -0.75rem;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--wh-accent-hi);
    display: grid;
    place-items: center;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
      color 0.15s ease;
  }

  @media (max-width: 30rem) {
    /* Icon-only logo: with the wordmark hidden there's no text box to centre the
       mark against, so return it to normal flow and drop the reserved slot so the
       link hugs the mark. */
    .wh-site-title {
      padding-inline-start: 0;
    }
    .wh-site-title__mark {
      position: static;
      margin-top: 0;
      display: inline-grid;
      vertical-align: middle;
    }
    .wh-site-title__text {
      display: none;
    }
  }
</style>
