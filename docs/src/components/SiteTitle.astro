---
import config from "virtual:starlight/user-config";

const title =
  typeof config.title === "string" ? config.title : config.title.en ?? "WaveHouse";
---

<a href={import.meta.env.BASE_URL} class="wh-site-title" aria-label={`${title} home`}>
  <span class="wh-site-title__mark" aria-hidden="true">
    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <g fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round">
        <path d="M10 14 Q18 32 10 50 T10 86"/>
        <path d="M30 14 Q38 32 30 50 T30 86"/>
        <path d="M50 14 Q58 32 50 50 T50 86"/>
        <path d="M70 14 Q78 32 70 50 T70 86"/>
      </g>
      <rect x="84" y="44" width="12" height="12" fill="currentColor"/>
    </svg>
  </span>
  <span class="wh-site-title__text">{title}</span>
</a>

<style>
  .wh-site-title {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    color: var(--wh-ink);
    font-weight: 650;
    letter-spacing: -0.02em;
    font-size: 1.0625rem;
    line-height: 1;
    transition: color 0.15s ease;
  }
  .wh-site-title:hover .wh-site-title__mark {
    color: var(--wh-accent);
    transform: rotate(-2deg);
  }
  .wh-site-title:hover .wh-site-title__text {
    color: var(--wh-ink);
  }
  .wh-site-title__mark {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--wh-accent-hi);
    display: grid;
    place-items: center;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
      color 0.15s ease;
  }
  .wh-site-title__mark svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .wh-site-title__text {
    font-feature-settings: "ss01";
  }

  @media (max-width: 30rem) {
    .wh-site-title__text {
      display: none;
    }
  }
</style>
