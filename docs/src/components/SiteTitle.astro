---
import config from "virtual:starlight/user-config";

const title =
  typeof config.title === "string" ? config.title : config.title.en ?? "WaveHouse";
const base = import.meta.env.BASE_URL;
---

<a href={base} class="wh-site-title" aria-label={`${title} home`}>
  {/*
    Image lockup (wave mark + "WaveHouse" wordmark) instead of live text — the
    branding-designed logo, so the wordmark is pixel-identical to the rest of the
    brand. Two pre-themed exports from public/branding, swapped by CSS on the
    site's `data-theme` (which defaults to dark); below 30rem it collapses to the
    compact mark, like the old text-hidden state. alt="" because the link's
    aria-label already names it — the images are decorative.
  */}
  <img class="wh-logo wh-logo--lockup wh-logo--on-dark" src={`${base}branding/lockup-dark.svg`} alt="" width="508" height="100" />
  <img class="wh-logo wh-logo--lockup wh-logo--on-light" src={`${base}branding/lockup-light.svg`} alt="" width="508" height="100" />
  <img class="wh-logo wh-logo--mark wh-logo--on-dark" src={`${base}branding/mark-dark.svg`} alt="" width="100" height="100" />
  <img class="wh-logo wh-logo--mark wh-logo--on-light" src={`${base}branding/mark-light.svg`} alt="" width="100" height="100" />
</a>

<style>
  .wh-site-title {
    display: inline-flex;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .wh-site-title:hover {
    opacity: 0.8;
  }

  .wh-logo {
    display: none;
    width: auto;
  }

  /* Full lockup — bottom-align its baked-in "WaveHouse" wordmark with the header
     row. The wordmark baseline sits at y74 of the lockup's 0–100 viewBox, so the
     image box extends 26% of its height BELOW that baseline (bottom padding + the
     wave mark, which dips below the wordmark by design). Nudge the image down by
     that 26% so — under `.wh-lead { align-items: baseline }` (Header.astro) — the
     WORDMARK, not the image's bottom edge, lands flush on the "Docs" baseline.
     The 26% is pure SVG geometry (100 − 74): no font metrics, so it holds at any
     DPI, zoom, or root font-size. */
  .wh-logo--lockup {
    height: 1.625rem;
    transform: translateY(calc(1.625rem * (100 - 74) / 100));
  }
  .wh-logo--mark {
    height: 1.5rem;
  }

  /* Exactly one logo is visible: the lockup at ≥30rem, the compact mark below —
     each swapped dark↔light on the theme (dark is the default when data-theme is
     unset, so the dark export shows unless [data-theme="light"] overrides). */
  @media (min-width: 30.0625rem) {
    .wh-logo--lockup.wh-logo--on-dark { display: block; }
    :root[data-theme="light"] .wh-logo--lockup.wh-logo--on-dark { display: none; }
    :root[data-theme="light"] .wh-logo--lockup.wh-logo--on-light { display: block; }
  }
  @media (max-width: 30rem) {
    .wh-logo--mark.wh-logo--on-dark { display: block; }
    :root[data-theme="light"] .wh-logo--mark.wh-logo--on-dark { display: none; }
    :root[data-theme="light"] .wh-logo--mark.wh-logo--on-light { display: block; }
  }
</style>
