---
import LiveDemo from "./LiveDemo.astro";

type HeroAction = {
  text: string;
  link: string;
  // Starlight parses `icon: external` (frontmatter string) into an icon object;
  // accept either shape.
  icon?: string | { type?: string; name?: string };
  variant?: "primary" | "secondary" | "minimal";
  attrs?: Record<string, string | number | boolean>;
};
type HeroData = {
  title?: string;
  tagline?: string;
  actions?: HeroAction[];
};

// Starlight's stable Hero contract passes props directly to component
// overrides; older Starlight (pre-0.30) exposed the same data via
// Astro.locals.starlightRoute.entry. Prefer props; fall back to locals so a
// minor-version bump that drops one or the other surfaces as a real error
// (entry undefined) rather than a silently-blank hero.
const heroProps = (Astro.props ?? {}) as {
  data?: { title?: string; hero?: HeroData };
  entry?: { data?: { title?: string; hero?: HeroData } };
};
const route = Astro.locals?.starlightRoute as
  | { entry?: { data?: { title?: string; hero?: HeroData } } }
  | undefined;
const data =
  heroProps.data ??
  heroProps.entry?.data ??
  route?.entry?.data ??
  {};
const heroData = (data.hero ?? {}) as HeroData;
const heroTitle = heroData.title || data.title || "";
const tagline = heroData.tagline;
const actions = heroData.actions ?? [];

if (import.meta.env.DEV && !heroTitle) {
  // Surfaces breakage immediately when a Starlight minor-version bump renames
  // the prop shape — without this, the hero renders silently blank.
  console.warn(
    "[Hero] Could not extract heroTitle from Starlight props — the hero will render blank. " +
      "Check the prop shape against the installed @astrojs/starlight version.",
  );
}
---

{/*
  The hero's entrance animations (staggered fade-up on text, the live demo
  panel rising in) should play once per tab session. Astro View Transitions
  re-mount the DOM on every navigation, so without this guard a user who
  nav'd /getting-started → / would see the whole opening sequence again.

  The inline script below runs synchronously during HTML parse — including
  on view-transition swaps (`data-astro-rerun`) — and stamps `data-hero-played`
  on <html> before the section paints when the in-memory flag is already set.
  CSS in this file's "style" block reads that attribute and short-circuits
  the entrance animations to their final state. Looping background animations
  (orb drift, the live panel's stream pulse, etc.) are not affected.

  `window.__whHeroPlayed` survives view transitions (same JS context) but is
  wiped by a hard page refresh — so a refresh of `/` still replays the hero.
*/}
<script is:inline data-astro-rerun>
  // Order matters: stamp the attribute BEFORE setting the flag, so the
  // current mount (the first one in this tab session) still gets the full
  // animation. Subsequent mounts — i.e. view-transition returns — find the
  // flag already set and stamp the attribute synchronously, before paint,
  // which suppresses the entrance animations via the [data-hero-played]
  // rules in this file's "style" block.
  //
  // Also stamps `[data-screenshot-ready]` on <html> for the
  // scripts/screenshot.mjs Playwright wait — on first mount the bottom-of-
  // file animationend listener stamps it once the visual column's entrance
  // finishes; on subsequent mounts the animations are suppressed, so there's
  // no animationend event and we set the ready marker here.
  if (typeof window !== "undefined") {
    if (window.__whHeroPlayed) {
      document.documentElement.setAttribute("data-hero-played", "");
      document.documentElement.setAttribute("data-screenshot-ready", "");
    } else {
      window.__whHeroPlayed = true;
    }
  }
</script>

<section class="wh-hero">
  <div class="wh-hero__inner">
    <div class="wh-hero__text">
      <span class="wh-pill" data-stagger="0">
        <span class="dot"></span>
        Open Source · Apache 2.0
      </span>

      <h1 class="wh-hero__title" data-stagger="1">
        <span class="wh-hero__title-line">{heroTitle}</span>
      </h1>

      {tagline && (
        <p class="wh-hero__tagline" data-stagger="2">{tagline}</p>
      )}

      {actions.length > 0 && (
        <div class="wh-hero__actions" data-stagger="3">
          {actions.map((action) => {
            const attrs = { ...(action.attrs ?? {}) };
            const iconName =
              typeof action.icon === "string" ? action.icon : action.icon?.name;
            if (attrs.target === "_blank") {
              const existing = String(attrs.rel ?? "").split(/\s+/).filter(Boolean);
              for (const token of ["noopener", "noreferrer"]) {
                if (!existing.includes(token)) existing.push(token);
              }
              attrs.rel = existing.join(" ");
            }
            return (
              <a
                href={action.link}
                class:list={[
                  "wh-hero__action",
                  `wh-hero__action--${action.variant ?? "primary"}`,
                ]}
                data-ph-cta={action.text}
                {...attrs}
              >
                <span>{action.text}</span>
                {action.variant === "primary" && (
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M5 12h14m-6-6 6 6-6 6"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                )}
                {/* External CTAs (e.g. "View on GitHub") get the ↗ glyph the
                    frontmatter asked for. Starlight parses `icon: external`
                    into an object ({type:'icon', name:'external'}), so check
                    both shapes — a bare string compare silently never matched. */}
                {action.variant !== "primary" && iconName === "external" && (
                  <svg
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M7 17 17 7m0 0H8m9 0v9"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                )}
              </a>
            );
          })}
        </div>
      )}

      <div class="wh-hero__meta" data-stagger="4">
        <button
          type="button"
          class="wh-hero__install"
          data-copy="pnpm add @wavehouse/sdk"
          aria-label="Copy: pnpm add @wavehouse/sdk"
        >
          <span class="wh-hero__install-prompt" aria-hidden="true">$</span>
          <span class="wh-hero__install-cmd">pnpm add <span class="wh-hero__install-pkg">@wavehouse/sdk</span></span>
          <span class="wh-hero__install-icon" aria-hidden="true">
            <svg class="wh-hero__install-copy" width="14" height="14" viewBox="0 0 24 24" fill="none">
              <rect x="9" y="9" width="11" height="11" rx="2.5" stroke="currentColor" stroke-width="2" />
              <path d="M5 15V5a2 2 0 0 1 2-2h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <svg class="wh-hero__install-check" width="14" height="14" viewBox="0 0 24 24" fill="none">
              <path d="M4 12.5 9 17.5 20 6.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </button>
        <span class="wh-hero__stars" data-wh-live-wrap hidden>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.5l2.95 5.98 6.6.96-4.78 4.65 1.13 6.58L12 17.57l-5.9 3.1 1.13-6.58L2.45 9.44l6.6-.96L12 2.5z" />
          </svg>
          <span data-wh-live="stars">—</span> stars · live
        </span>
      </div>
    </div>

    <div class="wh-hero__visual">
      <LiveDemo />
    </div>
  </div>
</section>

<script is:inline data-astro-rerun>
  // Stamp `[data-screenshot-ready]` on <html> when the visual column finishes
  // its entrance animation, so scripts/screenshot.mjs can wait on a real
  // signal rather than a magic timeout that drifts whenever the entrance
  // timing changes. Deliberately NOT tied to live data arriving — screenshots
  // must not hang on the demo instance being reachable. animationend bubbles
  // (the live panel's feed rows animate too), so match the target.
  (() => {
    if (document.documentElement.hasAttribute("data-screenshot-ready")) return;
    const visual = document.querySelector(".wh-hero__visual");
    if (!visual) return;
    visual.addEventListener("animationend", function onEnd(e) {
      if (e.target !== visual) return;
      visual.removeEventListener("animationend", onEnd);
      document.documentElement.setAttribute("data-screenshot-ready", "");
    });
  })();
</script>

<script is:inline>
  function setupHeroCTATracking() {
    document.querySelectorAll('.wh-hero__action[data-ph-cta]').forEach(function(el) {
      el.removeEventListener('click', el.__whPhHandler);
      el.__whPhHandler = function() {
        window.posthog?.capture('hero_cta_clicked', {
          cta_text: el.getAttribute('data-ph-cta'),
          cta_href: el.getAttribute('href'),
          cta_variant: el.classList.contains('wh-hero__action--primary') ? 'primary' : 'secondary'
        });
      };
      el.addEventListener('click', el.__whPhHandler);
    });
  }
  document.addEventListener('DOMContentLoaded', setupHeroCTATracking);
  document.addEventListener('astro:page-load', setupHeroCTATracking);

  // The install chip follows the reader's package-manager choice from the
  // docs' synced install tabs (Starlight persists the selected tab LABEL in
  // localStorage under its syncKey — see /sdk's <Tabs syncKey="pkg">). The
  // keys here must match those tab labels exactly. "CDN" (and anything
  // unknown) keeps the pnpm default — there's no one-liner shell command for
  // a script tag.
  function syncHeroInstallCmd() {
    var PKG_PREFIX = {
      pnpm: 'pnpm add ',
      npm: 'npm install ',
      yarn: 'yarn add ',
      bun: 'bun add ',
      deno: 'deno add npm:'
    };
    var label = null;
    try { label = localStorage.getItem('starlight-synced-tabs__pkg'); } catch (e) {}
    var prefix = label && PKG_PREFIX[label];
    if (!prefix) return;
    document.querySelectorAll('.wh-hero__install').forEach(function(btn) {
      var cmd = prefix + '@wavehouse/sdk';
      btn.setAttribute('data-copy', cmd);
      btn.setAttribute('aria-label', 'Copy: ' + cmd);
      var span = btn.querySelector('.wh-hero__install-cmd');
      // The command span is "<prefix text node><span.pkg>@wavehouse/sdk</span>".
      if (span && span.firstChild && span.firstChild.nodeType === Node.TEXT_NODE) {
        span.firstChild.nodeValue = prefix;
      }
    });
  }
  document.addEventListener('DOMContentLoaded', syncHeroInstallCmd);
  document.addEventListener('astro:page-load', syncHeroInstallCmd);

  // Click-to-copy install command — devs expect it, and it makes the SDK the
  // one-line "try it now". Falls back to a manual selection range when the
  // async clipboard API isn't available (http / older browsers).
  function setupHeroInstallCopy() {
    document.querySelectorAll('.wh-hero__install').forEach(function(btn) {
      if (btn.__whCopyBound) return;
      btn.__whCopyBound = true;
      btn.addEventListener('click', function() {
        var text = btn.getAttribute('data-copy') || '';
        var done = function() {
          btn.classList.add('is-copied');
          window.posthog?.capture('hero_install_copied', { text: text });
          clearTimeout(btn.__whCopyTimer);
          btn.__whCopyTimer = setTimeout(function() { btn.classList.remove('is-copied'); }, 1600);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done).catch(function() {});
        } else {
          try {
            var ta = document.createElement('textarea');
            ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
            document.body.appendChild(ta); ta.select(); document.execCommand('copy');
            document.body.removeChild(ta); done();
          } catch (e) {}
        }
      });
    });
  }
  document.addEventListener('DOMContentLoaded', setupHeroInstallCopy);
  document.addEventListener('astro:page-load', setupHeroInstallCopy);
</script>

<style>
  .wh-hero {
    position: relative;
    isolation: isolate;
    padding: 4rem 0 5rem;
    /* No overflow:hidden — the atmospheric grid + glow are now page-level
       (global.css, body:has(.wh-hero)::before/::after), so nothing here needs
       clipping and clipping is what trapped the old grid in a centered box. */
  }

  .wh-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  @media (max-width: 60rem) {
    .wh-hero__inner {
      /* minmax(0,…), not 1fr: a bare 1fr track floors at the column's
         min-content, which the live panel's 3-up stat grid pushes to ~325px —
         wider than a small phone, so the hero's overflow:hidden clipped the
         panel's right edge. min-width:0 lets it shrink to the viewport. */
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
  }

  .wh-hero__text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }
  /* Entrance fades + rises, but the opacity floor is a small NON-ZERO value,
     never 0. Chrome ignores an element painted at opacity:0 as an LCP
     candidate, and the hero is the only above-the-fold content — so a
     fade-from-0 disqualified its h1/tagline/panel and pushed LCP onto a tiny
     late element (a poor LCP, plus intermittent "NO_LCP" in PageSpeed on mobile
     when the live-demo number it landed on hadn't loaded). 0.01 is visually
     indistinguishable from 0 but keeps the element LCP-eligible from first
     paint; the translate carries the motion. Verified with Lighthouse mobile:
     LCP lands on the hero tagline, not the late live-demo number. The
     reduced-motion / replay-guard blocks below force opacity:1 (no fade). */
  .wh-hero__text > [data-stagger] {
    opacity: 0.01;
    transform: translateY(8px);
    animation: wh-fade-up 0.6s cubic-bezier(0.21, 0.61, 0.35, 1) forwards;
    animation-delay: calc(0.12s * var(--stagger, 0) + 0.05s);
  }
  .wh-hero__text > [data-stagger="0"] { --stagger: 0; }
  .wh-hero__text > [data-stagger="1"] { --stagger: 1; }
  .wh-hero__text > [data-stagger="2"] { --stagger: 2; }
  .wh-hero__text > [data-stagger="3"] { --stagger: 3; }
  .wh-hero__text > [data-stagger="4"] { --stagger: 4; }

  @keyframes wh-fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .wh-hero__title {
    margin: 0;
    font-size: clamp(2.5rem, 1.4rem + 3.6vw, 4.5rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.035em;
    background: linear-gradient(
      180deg,
      var(--wh-ink) 0%,
      color-mix(in oklab, var(--wh-ink) 55%, var(--wh-ink-muted)) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    /* Allow word-wrap below 30rem so longer titles don't horizontal-scroll;
       text-wrap: balance keeps the line breaks visually centered. */
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .wh-hero__title-line {
    display: inline;
  }

  .wh-hero__tagline {
    margin: 0;
    font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.25rem);
    line-height: 1.55;
    color: var(--wh-ink-muted);
    max-width: 36rem;
  }

  .wh-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  /* Stacked CTAs on small phones hug their labels at ragged widths — go
     full-width and centered so the pair reads as a deliberate stack. */
  @media (max-width: 30rem) {
    .wh-hero__actions {
      width: 100%;
    }
    .wh-hero__action {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
  .wh-hero__action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.05rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease,
      background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    line-height: 1;
  }
  .wh-hero__action--primary {
    background: var(--wh-accent);
    color: var(--wh-accent-ink);
    border: 1px solid var(--wh-accent-hi);
    box-shadow: var(--wh-shadow-glow);
  }
  .wh-hero__action--primary:hover {
    background: var(--wh-accent-hi);
    transform: translateY(-1px);
  }
  .wh-hero__action--secondary,
  .wh-hero__action--minimal {
    background: var(--wh-surface);
    color: var(--wh-ink);
    border: 1px solid var(--wh-border-strong);
  }
  .wh-hero__action--secondary:hover,
  .wh-hero__action--minimal:hover {
    border-color: var(--wh-accent);
    background: var(--wh-surface-elevated);
    transform: translateY(-1px);
  }

  .wh-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 1rem;
    margin-top: 0.25rem;
    color: var(--wh-ink-subtle);
    font-size: 0.875rem;
  }

  /* Click-to-copy install command — a faux terminal chip. */
  .wh-hero__install {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.7rem;
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    line-height: 1;
    background: var(--wh-code-bg);
    border: 1px solid var(--wh-code-border);
    border-radius: var(--radius-sm);
    color: var(--wh-ink-muted);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
  }
  .wh-hero__install:hover {
    border-color: var(--wh-accent);
    transform: translateY(-1px);
  }
  .wh-hero__install-prompt { color: var(--wh-accent-text); font-weight: 700; }
  .wh-hero__install-pkg { color: var(--wh-ink); }
  .wh-hero__install-icon {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 14px;
    height: 14px;
    margin-left: 0.1rem;
    color: var(--wh-ink-subtle);
  }
  .wh-hero__install-icon svg { position: absolute; transition: opacity 0.15s ease, transform 0.15s ease; }
  .wh-hero__install:hover .wh-hero__install-copy { color: var(--wh-accent-text); }
  .wh-hero__install-check { color: var(--wh-emerald); opacity: 0; transform: scale(0.6); }
  .wh-hero__install.is-copied .wh-hero__install-copy { opacity: 0; transform: scale(0.6); }
  .wh-hero__install.is-copied .wh-hero__install-check { opacity: 1; transform: scale(1); }
  .wh-hero__install.is-copied { border-color: var(--wh-emerald); }

  /* Live star count — social proof fed by the same demo data (data-wh-live). */
  .wh-hero__stars {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8125rem;
    color: var(--wh-ink-subtle);
  }
  .wh-hero__stars svg { color: var(--wh-amber); }
  .wh-hero__stars [data-wh-live] {
    color: var(--wh-ink);
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }
  /* display:inline-flex would otherwise beat the [hidden] UA default — keep the
     chip hidden until the live star count arrives. */
  .wh-hero__stars[hidden] { display: none; }

  .wh-hero__visual {
    position: relative;
    display: flex;
    min-width: 0; /* flex child default min-width:auto would re-floor the panel at min-content */
    opacity: 0.01;
    transform: translateY(8px);
    animation: wh-fade-up 0.8s 0.3s cubic-bezier(0.21, 0.61, 0.35, 1) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .wh-hero__text > [data-stagger],
    .wh-hero__visual {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* Replay guard: once the entrance animations have played in this tab
     session, render straight to the final state on subsequent mounts (view
     transitions). The looping animations (orb drift, the live panel's
     stream pulse) keep running — only the one-shot entrance choreography
     is suppressed. The live panel's feed-row animations are driven by data
     arrival, not page entrance, so they stay out of this guard. */
  :root[data-hero-played] .wh-hero__text > [data-stagger],
  :root[data-hero-played] .wh-hero__visual {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
</style>
