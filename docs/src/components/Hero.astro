---
type HeroAction = {
  text: string;
  link: string;
  icon?: string;
  variant?: "primary" | "secondary" | "minimal";
  attrs?: Record<string, string | number | boolean>;
};
type HeroData = {
  title?: string;
  tagline?: string;
  actions?: HeroAction[];
};

// Starlight's stable Hero contract passes props directly to component
// overrides; older Starlight (pre-0.30) exposed the same data via
// Astro.locals.starlightRoute.entry. Prefer props; fall back to locals so a
// minor-version bump that drops one or the other surfaces as a real error
// (entry undefined) rather than a silently-blank hero.
const heroProps = (Astro.props ?? {}) as {
  data?: { title?: string; hero?: HeroData };
  entry?: { data?: { title?: string; hero?: HeroData } };
};
const route = Astro.locals?.starlightRoute as
  | { entry?: { data?: { title?: string; hero?: HeroData } } }
  | undefined;
const data =
  heroProps.data ??
  heroProps.entry?.data ??
  route?.entry?.data ??
  {};
const heroData = (data.hero ?? {}) as HeroData;
const heroTitle = heroData.title || data.title || "";
const tagline = heroData.tagline;
const actions = heroData.actions ?? [];

if (import.meta.env.DEV && !heroTitle) {
  // Surfaces breakage immediately when a Starlight minor-version bump renames
  // the prop shape — without this, the hero renders silently blank.
  console.warn(
    "[Hero] Could not extract heroTitle from Starlight props — the hero will render blank. " +
      "Check the prop shape against the installed @astrojs/starlight version.",
  );
}

type TerminalLine =
  | { kind: "command"; cmd: string }
  | { kind: "ok"; text: string; dim?: string; accent?: string }
  | { kind: "arrow"; text: string; dim?: string }
  | { kind: "json"; text: string }
  | { kind: "cursor" };

const terminalLines: TerminalLine[] = [
  { kind: "command", cmd: "docker run -p 8080:8080 ghcr.io/wave-rf/wavehouse" },
  { kind: "ok", text: "NATS JetStream embedded — ready" },
  { kind: "ok", text: "ClickHouse schema discovered ", dim: "(4 tables)" },
  { kind: "ok", text: "Listening on ", accent: "http://localhost:8080" },
  { kind: "command", cmd: "wave subscribe events --live" },
  { kind: "arrow", text: "events_v1 ", dim: "[SSE 200]" },
  { kind: "json", text: '{"id":"evt_01","kind":"click",...}' },
  { kind: "json", text: '{"id":"evt_02","kind":"view",...}' },
  { kind: "cursor" },
];
---

{/*
  The hero's entrance animations (staggered fade-up on text, terminal lines
  typing in) should play once per tab session. Astro View Transitions
  re-mount the DOM on every navigation, so without this guard a user who
  nav'd /getting-started → / would see the whole opening sequence again.

  The inline script below runs synchronously during HTML parse — including
  on view-transition swaps (`data-astro-rerun`) — and stamps `data-hero-played`
  on <html> before the section paints when the in-memory flag is already set.
  CSS in this file's <style> block reads that attribute and short-circuits
  the entrance animations to their final state. Looping background animations
  (orb drift, wave drift, cursor blink, etc.) are not affected.

  `window.__whHeroPlayed` survives view transitions (same JS context) but is
  wiped by a hard page refresh — so a refresh of `/` still replays the hero.
*/}
<script is:inline data-astro-rerun>
  // Order matters: stamp the attribute BEFORE setting the flag, so the
  // current mount (the first one in this tab session) still gets the full
  // animation. Subsequent mounts — i.e. view-transition returns — find the
  // flag already set and stamp the attribute synchronously, before paint,
  // which suppresses the entrance animations via the [data-hero-played]
  // rules in this file's <style> block.
  if (typeof window !== "undefined") {
    if (window.__whHeroPlayed) {
      document.documentElement.setAttribute("data-hero-played", "");
    } else {
      window.__whHeroPlayed = true;
    }
  }
</script>

<section class="wh-hero">
  <div class="wh-hero__bg" aria-hidden="true">
    <div class="wh-hero__grid"></div>
    <div class="wh-hero__orb wh-hero__orb--a"></div>
    <div class="wh-hero__orb wh-hero__orb--b"></div>
  </div>

  <div class="wh-hero__inner">
    <div class="wh-hero__text">
      <span class="wh-pill" data-stagger="0">
        <span class="dot"></span>
        open source · MIT
      </span>

      <h1 class="wh-hero__title" data-stagger="1">
        <span class="wh-hero__title-line">{heroTitle}</span>
      </h1>

      {tagline && (
        <p class="wh-hero__tagline" data-stagger="2">{tagline}</p>
      )}

      {actions.length > 0 && (
        <div class="wh-hero__actions" data-stagger="3">
          {actions.map((action) => {
            const attrs = { ...(action.attrs ?? {}) };
            if (attrs.target === "_blank") {
              const existing = String(attrs.rel ?? "").split(/\s+/).filter(Boolean);
              for (const token of ["noopener", "noreferrer"]) {
                if (!existing.includes(token)) existing.push(token);
              }
              attrs.rel = existing.join(" ");
            }
            return (
              <a
                href={action.link}
                class:list={[
                  "wh-hero__action",
                  `wh-hero__action--${action.variant ?? "primary"}`,
                ]}
                {...attrs}
              >
                <span>{action.text}</span>
                {action.variant === "primary" && (
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M5 12h14m-6-6 6 6-6 6"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                )}
              </a>
            );
          })}
        </div>
      )}

      <div class="wh-hero__meta" data-stagger="4">
        <span class="wh-hero__meta-item">
          <kbd>pnpm add</kbd>
          <span>@wavehouse/sdk</span>
        </span>
      </div>
    </div>

    <div class="wh-hero__visual">
      <div class="wh-hero__svg-wrap">
      <svg
        class="wh-hero__mesh"
        viewBox="0 0 480 320"
        preserveAspectRatio="xMidYMid slice"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label="Animated wave-mesh signal propagation"
      >
        <defs>
          <linearGradient id="wh-fade" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="currentColor" stop-opacity="0" />
            <stop offset="0.15" stop-color="currentColor" stop-opacity="0.9" />
            <stop offset="0.85" stop-color="currentColor" stop-opacity="0.9" />
            <stop offset="1" stop-color="currentColor" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="wh-fade-soft" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="currentColor" stop-opacity="0" />
            <stop offset="0.5" stop-color="currentColor" stop-opacity="0.35" />
            <stop offset="1" stop-color="currentColor" stop-opacity="0" />
          </linearGradient>
        </defs>

        <g class="wh-mesh-lines" stroke="currentColor" stroke-opacity="0.18" stroke-width="1">
          <line x1="80" y1="80" x2="240" y2="160" />
          <line x1="80" y1="80" x2="160" y2="240" />
          <line x1="240" y1="160" x2="160" y2="240" />
          <line x1="240" y1="160" x2="400" y2="80" />
          <line x1="240" y1="160" x2="380" y2="240" />
          <line x1="160" y1="240" x2="380" y2="240" />
          <line x1="400" y1="80" x2="380" y2="240" />
        </g>

        <g class="wh-waves" stroke="currentColor" fill="none" stroke-linecap="round">
          <path
            class="wh-wave wh-wave--a"
            d="M -40 160 Q 0 100, 40 160 T 120 160 T 200 160 T 280 160 T 360 160 T 440 160 T 520 160"
            stroke="url(#wh-fade)"
            stroke-width="3"
            stroke-opacity="0.95"
          />
          <path
            class="wh-wave wh-wave--b"
            d="M -40 190 Q 0 230, 40 190 T 120 190 T 200 190 T 280 190 T 360 190 T 440 190 T 520 190"
            stroke="url(#wh-fade-soft)"
            stroke-width="2.2"
            stroke-opacity="0.6"
          />
          <path
            class="wh-wave wh-wave--c"
            d="M -40 130 Q 0 90, 40 130 T 120 130 T 200 130 T 280 130 T 360 130 T 440 130 T 520 130"
            stroke="url(#wh-fade-soft)"
            stroke-width="1.6"
            stroke-opacity="0.45"
          />
        </g>

        <g class="wh-mesh-nodes" fill="currentColor">
          <circle class="wh-node wh-node--1" cx="80" cy="80" r="5" />
          <circle class="wh-node wh-node--2" cx="240" cy="160" r="6.5" />
          <circle class="wh-node wh-node--3" cx="160" cy="240" r="5" />
          <circle class="wh-node wh-node--4" cx="400" cy="80" r="5" />
          <circle class="wh-node wh-node--5" cx="380" cy="240" r="5" />
        </g>

        <g class="wh-rings" stroke="currentColor" fill="none" stroke-width="1.5">
          <circle class="wh-ring wh-ring--1" cx="240" cy="160" r="16" />
          <circle class="wh-ring wh-ring--2" cx="240" cy="160" r="16" />
          <circle class="wh-ring wh-ring--3" cx="240" cy="160" r="16" />
        </g>
      </svg>
      </div>

      <div class="wh-terminal" aria-hidden="true">
        <div class="wh-terminal__chrome">
          <span class="wh-terminal__dot wh-terminal__dot--red"></span>
          <span class="wh-terminal__dot wh-terminal__dot--amber"></span>
          <span class="wh-terminal__dot wh-terminal__dot--green"></span>
          <span class="wh-terminal__title">wavehouse-cli</span>
        </div>
        <pre class="wh-terminal__body"><code>{terminalLines.map((line, i) => {
          if (line.kind === "command") {
            return (
              <span class="wh-line" style={`--i:${i}`}>
                <span class="wh-prompt">$</span>{" "}
                <span class="wh-cmd">{line.cmd}</span>
              </span>
            );
          }
          if (line.kind === "ok") {
            return (
              <span class="wh-line wh-line--out" style={`--i:${i}`}>
                <span class="wh-ok">✓</span> {line.text}
                {line.dim && <span class="wh-dim">{line.dim}</span>}
                {line.accent && <span class="wh-accent">{line.accent}</span>}
              </span>
            );
          }
          if (line.kind === "arrow") {
            return (
              <span class="wh-line wh-line--out" style={`--i:${i}`}>
                <span class="wh-arrow">→</span> {line.text}
                {line.dim && <span class="wh-dim">{line.dim}</span>}
              </span>
            );
          }
          if (line.kind === "json") {
            return (
              <span class="wh-line wh-line--out" style={`--i:${i}`}>
                <span class="wh-json">{line.text}</span>
              </span>
            );
          }
          return (
            <span class="wh-line wh-line--cursor" style={`--i:${i}`}>
              <span class="wh-cursor">▌</span>
            </span>
          );
        })}</code></pre>
      </div>
    </div>
  </div>
</section>

<style>
  .wh-hero {
    position: relative;
    isolation: isolate;
    padding: 4rem 0 5rem;
    overflow: hidden;
  }
  .wh-hero__bg {
    position: absolute;
    inset: -10% -5% 0;
    pointer-events: none;
    z-index: -1;
  }
  .wh-hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--wh-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--wh-border) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: -1px -1px;
    opacity: 0.35;
    mask-image: radial-gradient(
      ellipse 60% 70% at 50% 30%,
      black 0%,
      black 40%,
      transparent 80%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 60% 70% at 50% 30%,
      black 0%,
      black 40%,
      transparent 80%
    );
  }
  .wh-hero__orb {
    position: absolute;
    border-radius: 999px;
    filter: blur(96px);
    pointer-events: none;
  }
  .wh-hero__orb--a {
    width: 320px;
    height: 320px;
    background: var(--wh-accent);
    top: 10%;
    right: 8%;
    opacity: 0.22;
    animation: wh-orb-drift 16s ease-in-out infinite alternate;
  }
  .wh-hero__orb--b {
    width: 280px;
    height: 280px;
    background: var(--wh-sky);
    bottom: -10%;
    left: 6%;
    opacity: 0.18;
    animation: wh-orb-drift 22s ease-in-out -8s infinite alternate;
  }

  @keyframes wh-orb-drift {
    0%   { transform: translate(0, 0) scale(1); }
    100% { transform: translate(-30px, 40px) scale(1.12); }
  }

  .wh-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  @media (max-width: 60rem) {
    .wh-hero__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .wh-hero__text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }
  .wh-hero__text > [data-stagger] {
    opacity: 0;
    transform: translateY(8px);
    animation: wh-fade-up 0.6s cubic-bezier(0.21, 0.61, 0.35, 1) forwards;
    animation-delay: calc(0.12s * var(--stagger, 0) + 0.05s);
  }
  .wh-hero__text > [data-stagger="0"] { --stagger: 0; }
  .wh-hero__text > [data-stagger="1"] { --stagger: 1; }
  .wh-hero__text > [data-stagger="2"] { --stagger: 2; }
  .wh-hero__text > [data-stagger="3"] { --stagger: 3; }
  .wh-hero__text > [data-stagger="4"] { --stagger: 4; }

  @keyframes wh-fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .wh-hero__title {
    margin: 0;
    font-size: clamp(2.5rem, 1.4rem + 3.6vw, 4.5rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.035em;
    background: linear-gradient(
      180deg,
      var(--wh-ink) 0%,
      color-mix(in oklab, var(--wh-ink) 55%, var(--wh-ink-muted)) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    /* Allow word-wrap below 30rem so longer titles don't horizontal-scroll;
       text-wrap: balance keeps the line breaks visually centered. */
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .wh-hero__title-line {
    display: inline;
  }

  .wh-hero__tagline {
    margin: 0;
    font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.25rem);
    line-height: 1.55;
    color: var(--wh-ink-muted);
    max-width: 36rem;
  }

  .wh-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .wh-hero__action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.1rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease,
      background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    line-height: 1;
  }
  .wh-hero__action--primary {
    background: var(--wh-accent);
    color: var(--wh-accent-ink);
    border: 1px solid var(--wh-accent-hi);
    box-shadow: var(--wh-shadow-glow);
  }
  .wh-hero__action--primary:hover {
    background: var(--wh-accent-hi);
    transform: translateY(-1px);
  }
  .wh-hero__action--secondary,
  .wh-hero__action--minimal {
    background: var(--wh-surface);
    color: var(--wh-ink);
    border: 1px solid var(--wh-border-strong);
  }
  .wh-hero__action--secondary:hover,
  .wh-hero__action--minimal:hover {
    border-color: var(--wh-accent);
    background: var(--wh-surface-elevated);
  }

  .wh-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
    color: var(--wh-ink-subtle);
    font-size: 0.875rem;
  }
  .wh-hero__meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .wh-hero__meta kbd {
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    background: var(--wh-surface);
    border: 1px solid var(--wh-border);
    border-radius: 0.375rem;
    padding: 0.2rem 0.5rem;
    color: var(--wh-ink-muted);
    font-weight: 500;
  }

  .wh-hero__visual {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    opacity: 0;
    transform: translateY(8px);
    animation: wh-fade-up 0.8s 0.3s cubic-bezier(0.21, 0.61, 0.35, 1) forwards;
  }
  .wh-hero__svg-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 480 / 320;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: radial-gradient(
      ellipse at 60% 40%,
      color-mix(in oklab, var(--wh-accent) 8%, transparent) 0%,
      transparent 70%
    );
  }
  .wh-hero__mesh {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--wh-accent-hi);
    pointer-events: none;
    overflow: visible;
  }

  .wh-wave {
    animation: wh-wave-drift linear infinite;
  }
  .wh-wave--a { animation-duration: 7s; }
  .wh-wave--b { animation-duration: 11s; animation-direction: reverse; }
  .wh-wave--c { animation-duration: 13s; }
  @keyframes wh-wave-drift {
    from { transform: translateX(0); }
    to   { transform: translateX(-160px); }
  }

  .wh-node {
    transform-origin: center;
    transform-box: fill-box;
    animation: wh-node-pulse 2.6s ease-in-out infinite;
  }
  .wh-node--1 { animation-delay: 0s; }
  .wh-node--2 { animation-delay: 0.4s; }
  .wh-node--3 { animation-delay: 0.8s; }
  .wh-node--4 { animation-delay: 1.2s; }
  .wh-node--5 { animation-delay: 1.6s; }
  @keyframes wh-node-pulse {
    0%, 100% {
      transform: scale(1);
      opacity: 0.55;
      filter: drop-shadow(0 0 0 transparent);
    }
    50% {
      transform: scale(1.4);
      opacity: 1;
      filter: drop-shadow(0 0 6px var(--wh-accent-glow-strong));
    }
  }

  .wh-ring {
    transform-origin: center;
    transform-box: fill-box;
    opacity: 0;
    animation: wh-ring-expand 3.2s cubic-bezier(0.21, 0.61, 0.35, 1) infinite;
  }
  .wh-ring--2 { animation-delay: 1.1s; }
  .wh-ring--3 { animation-delay: 2.1s; }
  @keyframes wh-ring-expand {
    0%   { transform: scale(0.4); opacity: 0; stroke-opacity: 0.6; }
    20%  { opacity: 1; }
    100% { transform: scale(3.2); opacity: 0; stroke-opacity: 0; }
  }

  .wh-mesh-lines line {
    stroke-dasharray: 4 3;
    animation: wh-dash-drift 10s linear infinite;
  }
  @keyframes wh-dash-drift {
    to { stroke-dashoffset: -28; }
  }

  /* Terminal demo */
  .wh-terminal {
    position: relative;
    width: 100%;
    border-radius: 0.75rem;
    background: var(--wh-code-bg);
    border: 1px solid var(--wh-code-border);
    box-shadow: var(--wh-shadow-lg);
    overflow: hidden;
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    line-height: 1.55;
  }
  .wh-terminal__chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.85rem;
    border-bottom: 1px solid var(--wh-code-border);
    background: color-mix(in oklab, var(--wh-code-bg) 80%, var(--wh-surface));
  }
  .wh-terminal__dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
  }
  .wh-terminal__dot--red   { background: #ff5f57; }
  .wh-terminal__dot--amber { background: #febc2e; }
  .wh-terminal__dot--green { background: #28c840; }
  .wh-terminal__title {
    margin-left: 0.5rem;
    color: var(--wh-ink-subtle);
    font-size: 0.7rem;
  }
  .wh-terminal__body {
    margin: 0;
    padding: 0.85rem 1rem 1rem;
    background: var(--wh-code-bg);
    color: var(--wh-ink);
    overflow: hidden;
  }
  .wh-terminal__body code {
    display: block;
    background: transparent;
    padding: 0;
    border: 0;
    font: inherit;
    color: inherit;
  }
  .wh-line {
    display: block;
    opacity: 0;
    animation: wh-line-in 0.4s ease-out forwards;
    animation-delay: calc(0.55s + var(--i, 0) * 0.42s);
  }
  @keyframes wh-line-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .wh-prompt { color: var(--wh-accent-hi); font-weight: 600; }
  .wh-cmd    { color: var(--wh-ink); }
  .wh-ok     { color: var(--wh-emerald, #10B981); font-weight: 600; }
  .wh-arrow  { color: var(--wh-accent-hi); }
  .wh-accent { color: var(--wh-accent-hi); }
  .wh-dim    { color: var(--wh-ink-subtle); }
  .wh-json   { color: var(--wh-sky); }
  .wh-cursor {
    display: inline-block;
    color: var(--wh-accent-hi);
    animation: wh-blink 1.05s steps(2, end) infinite;
  }
  @keyframes wh-blink {
    50% { opacity: 0; }
  }

  :root[data-theme="light"] .wh-hero__orb--a { opacity: 0.16; }
  :root[data-theme="light"] .wh-hero__orb--b { opacity: 0.12; }

  @media (prefers-reduced-motion: reduce) {
    .wh-hero__orb,
    .wh-wave,
    .wh-node,
    .wh-ring,
    .wh-mesh-lines line,
    .wh-cursor,
    .wh-line,
    .wh-hero__text > [data-stagger],
    .wh-hero__visual {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* Replay guard: once the entrance animations have played in this tab
     session, render straight to the final state on subsequent mounts (view
     transitions). The looping animations (orb drift, node pulse, ring
     expand, wave drift, cursor blink) keep running — only the one-shot
     entrance choreography is suppressed. */
  :root[data-hero-played] .wh-hero__text > [data-stagger],
  :root[data-hero-played] .wh-hero__visual,
