  {
    "name": "complex query combining everything",
    "endpoint": "query",
    "table": "clicks",
    "operations": [
      { "method": "select", "args": ["page"] },
      { "method": "where", "args": ["score", ">", 10] },
      { "method": "count", "args": ["*", "total"] },
      { "method": "groupBy", "args": ["page"] },
      { "method": "orderBy", "args": ["total", "desc"] },
      { "method": "limit", "args": [50] },
      { "method": "timeRange", "args": ["received_timestamp", "1h", ""] }
    ],
    "expected_body": {
      "columns": ["page"],
      "filters": [{ "column": "score", "op": "gt", "value": 10 }],
      "aggregations": [{ "fn": "count", "column": "*", "alias": "total" }],
      "group_by": ["page"],
      "order_by": [{ "column": "total", "dir": "desc" }],
      "limit": 50,
      "time_range": { "column": "received_timestamp", "since": "1h" }
    }
  },
