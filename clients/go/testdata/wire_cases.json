[
  {
    "name": "bare query defaults to select_all",
    "endpoint": "query",
    "table": "clicks",
    "operations": [],
    "expected_path": "/v1/query?table=clicks",
    "expected_method": "POST",
    "expected_body": {
      "select_all": true,
      "limit": 1000
    }
  },
  {
    "name": "select explicit columns",
    "endpoint": "query",
    "table": "clicks",
    "operations": [
